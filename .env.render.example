# Variables d'environnement pour Render (SmartTransport API)
# Render injecte automatiquement RENDER_EXTERNAL_URL et DB_URL via render.yaml.
# Copiez ce fichier comme référence si vous configurez manuellement le dashboard.

APP_NAME=SmartTransport
APP_ENV=production
APP_KEY=                        # Généré automatiquement par Render
APP_DEBUG=false
APP_URL=                        # Laissé vide : rempli via RENDER_EXTERNAL_URL au démarrage

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_SSLMODE=require
DB_URL=                         # Injecté depuis la base PostgreSQL Render

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

SEED_DATABASE=true              # Mettre à false après le premier déploiement
